# Copy to .env and adjust if needed. docker-compose.yml's own defaults match
# these values exactly, so the stack works fine without a .env at all.
#
# Postgres only applies POSTGRES_USER/PASSWORD/DB the first time it
# initializes the pgdata volume — changing them later and re-running
# `docker compose up` has no effect on an already-initialized volume.
# `docker compose down -v` first if you need new credentials to take.

POSTGRES_USER=ticketbox
POSTGRES_PASSWORD=ticketbox
POSTGRES_DB=ticketbox

DATABASE_URL=postgresql://ticketbox:ticketbox@localhost:5432/ticketbox
REDIS_URL=redis://localhost:6379
